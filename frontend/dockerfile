# Stage 1: Build Vite React application using Node 24
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Stage 2: Serve static build using Nginx
FROM nginx:alpine

# Copy built dist files to Nginx web directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose Vite preview / custom port 1573
EXPOSE 1573

CMD ["nginx", "-g", "daemon off;"]